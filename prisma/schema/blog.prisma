model Blog {
  id          String   @id @default(uuid())
  title       String
  slug        String   @unique
  excerpt     String?
  // HTML generated from `blocks` (kept for search/RAG and for older posts)
  content     String
  // Ordered content blocks: heading / text / image
  blocks      Json?
  coverImage  String?
  author      String?
  isPublished Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([slug])
  @@map("blogs")
}
