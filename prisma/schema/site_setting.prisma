model SiteSetting {
  id          String  @id @default("default") // a single row
  siteName    String  @default("Bangladeshi IT")
  tagline     String?
  description String  @default("Software, web, and IT solutions built for growing businesses.")
  logo        String?
  phone       String?
  email       String?
  address     String?

  facebook  String?
  youtube   String?
  instagram String?
  linkedin  String?
  tiktok    String?
  whatsapp  String?

  copyrightText String @default("All rights reserved.")

  updatedAt DateTime @updatedAt

  @@map("site_settings")
}
