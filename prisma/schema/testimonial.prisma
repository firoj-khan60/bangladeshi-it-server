// Client testimonials shown in the home page slider
model Testimonial {
  id        String   @id @default(uuid())
  name      String
  role      String?
  content   String
  avatar    String?
  rating    Int      @default(5)
  order     Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("testimonials")
}
